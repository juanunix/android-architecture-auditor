interface SFInteractionsLayoutsUseCase {
    suspend operator fun invoke(action: SFInteractionAction):
            ClaroResult<SFInteractionsLayoutsModel, ErrorResponse>
}

internal class SFInteractionsLayoutsUseCaseImpl(
    private val repository: SFInteractionsLayoutsRepository,
    private val mapper: SFInteractionsLayoutsMapper
) : SFInteractionsLayoutsUseCase {
    override suspend fun invoke(action: SFInteractionAction): ClaroResult<SFInteractionsLayoutsModel, ErrorResponse> {
        return repository.getInteractionLayout(action = action)
            .mapSuccess { mapper.mapFrom(it) }
            .mapError { it }
    }
}


