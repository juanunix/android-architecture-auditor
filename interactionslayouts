import androidx.annotation.Keep
import br.com.claro.flex.cfanalytics.dynatrace.ClaroDynatraceEventsRouter
import br.com.claro.flex.core.extensions.isDecodeError
import br.com.claro.flex.core_network.domain.model.ErrorModel
import br.com.claro.flex.core_network.remote.response.ErrorResponse
import br.com.claro.flex.core_network.remote.response.NpErrorResponse
import br.com.claro.flex.core_network.remote.response.UNEXPECTED
import kotlinx.coroutines.CoroutineDispatcher
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import retrofit2.HttpException

@Keep
suspend fun <T> safeApiCall(
    dispatcher: CoroutineDispatcher = Dispatchers.IO,
    dynatraceEventsRouter: ClaroDynatraceEventsRouter? = null,
    apiCall: suspend () -> T
): ClaroResult<T, ErrorResponse> {
    return withContext(dispatcher) {
        try {
            ClaroResult.Success(apiCall())
        } catch (exception: Exception) {
            val errorResponseException = exception as? ErrorResponse
            ClaroResult.Error(
                when (exception) {
                    is NpErrorResponse -> {
                        getNpExceptionError(exception)
                    }

                    else -> {
                        errorResponseException ?: getExceptionError(exception)
                    }
                }
            )
        }
    }
}

private fun getExceptionError(exception: java.lang.Exception): ErrorResponse {
    return ErrorResponse(
        statusCode = getExceptionErrorCode(exception).toIntOrNull(),
        message = "Algo deu errado! Não foi possível atender sua solicitação neste momento. Por favor, tente novamente."
    )
}

private fun getExceptionErrorCode(exception: java.lang.Exception) =
    if (exception is HttpException) {
        exception.code().toString()
    } else {
        UNEXPECTED
    }

private fun getNpExceptionError(exception: java.lang.Exception): ErrorResponse {
    return (exception as? NpErrorResponse)?.toErrorResponse() ?: ErrorResponse()
}

fun ErrorResponse.toErrorModel() = ErrorModel(
    errorCode = this.code.orEmpty(),
    message = this.message.orEmpty(),
    detailedMessage = this.detailedMessage.orEmpty(),
    response = this.response
)

fun NpErrorResponse.toErrorResponse() = ErrorResponse(
    message = this.error?.message.orEmpty(),
    detailedMessage = this.error?.detailedMessage.orEmpty(),
    statusCode = this.error?.httpCode?.toIntOrNull(),
    code = this.error?.errorCode.orEmpty(),
    response = this.response
)

