interface SFInteractionsLayoutsMapper :
    Mapper<ResponseGeneric<SFInteractionsLayoutsResponse>, SFInteractionsLayoutsModel>

internal class SFInteractionsLayoutsMapperImpl : SFInteractionsLayoutsMapper {
    override fun mapFrom(from: ResponseGeneric<SFInteractionsLayoutsResponse>): SFInteractionsLayoutsModel {
        val data = from.data?.screen
        return SFInteractionsLayoutsModel(
            icon = data?.icon.orEmpty(),
            title = data?.title.orEmpty(),
            description = data?.description.orEmpty(),
            items = data?.items?.map {
                SFClaroItemsModel(
                    order = it.order.orZero(),
                    icon = it.icon.orEmpty(),
                    text = it.text.orEmpty()
                )

            } ?: emptyList(),
            bottomButtons = data?.bottomButtons?.map {
                SFClaroButtonModel(
                    title = it.title.orEmpty(),
                    action = it.action.orEmpty(),
                    type = getTypeOrDefault(it.type?.uppercase().orEmpty(), ButtonStyleType.PRIMARY)
                )
            } ?: emptyList()
        )
    }
}
fun SFInteractionsLayoutsModel.toCFLayoutsModel() =
    CFLayoutsUiModel(
        icon = this.icon,
        title = this.title,
        description = this.description,
        items = this.items.map {
            CFLayoutsItemUiModel(
                order = it.order,
                icon = it.icon,
                text = it.text
            )
        },
        bottomButtons = this.bottomButtons.map {
            CFClaroButtonUiModel(
                title = it.title,
                action = it.action,
                type = it.type
            )
        }
    )


